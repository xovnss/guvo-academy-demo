{
  "name": "guvo-academy-demo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Motor de simulaciones de capacitación con IA: termómetro emocional, evaluación por criterios, coaching con RAG y certificados verificables.",
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "start": "node --experimental-strip-types --env-file-if-exists=.env.local src/main.ts",
    "test": "node --experimental-strip-types --test \"tests/**/*.test.ts\"",
    "eval": "node --experimental-strip-types --env-file-if-exists=.env.local evals/run.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.8.0"
  }
}
