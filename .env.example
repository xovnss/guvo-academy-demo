# Copia este archivo como .env.local. Sin ninguna variable la demo corre con reglas en español (sin IA externa).

# Secreto para firmar certificados (cualquier cadena larga y aleatoria). Sin él, los certificados
# dejan de ser verificables cuando se reinicia el servidor.
CERT_SECRET=

# LLM opcional: evalúa los mensajes y hace hablar al interlocutor de forma dinámica.
# Si falla o responde algo inválido, el sistema cae automáticamente a las reglas.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
